MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=devatlas
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Optional: seed a local demo maintainer (leave blank in shared environments)
DEMO_EMAIL=
DEMO_PASSWORD=
# Optional: private repos + higher GitHub rate limit for /api/ingest/github
GITHUB_TOKEN=
# Optional: Bitbucket Cloud private repos for /api/ingest/bitbucket
# Either an app password (with your Bitbucket username) or a repository/workspace access token
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_TOKEN=
# Optional: any https Git host for /api/ingest/git (GitLab, Azure DevOps, Bitbucket Server...)
# Token alone is sent as a Bearer header; with a username it is sent as Basic auth
GIT_HTTP_USERNAME=
GIT_HTTP_TOKEN=
# Optional: comma-separated hosts allowed for /api/ingest/git (empty = any https host)
GIT_ALLOWED_HOSTS=
