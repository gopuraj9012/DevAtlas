MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=devatlas
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Local demo accounts (see README "Roles and demo logins").
# These passwords are public. Blank all four before running DevAtlas anywhere shared.
DEMO_EMAIL=greta@gmail.com
DEMO_PASSWORD=Greta@1234
DEMO_ENGINEER_EMAIL=priya@devatlas.local
DEMO_ENGINEER_PASSWORD=Priya@1234
# First owner (admin): comma-separated emails promoted to owner at startup, only while no active owner exists.
# Put your own email here, sign up, restart the API, then manage everyone else from the Admin screen.
BOOTSTRAP_OWNERS=
# Optional: private repos + higher GitHub rate limit for /api/ingest/github
GITHUB_TOKEN=
# Optional: Bitbucket Cloud private repos for /api/ingest/bitbucket
# Either an app password (with your Bitbucket username) or a repository/workspace access token
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_TOKEN=
# Optional: any https Git host for /api/ingest/git (GitLab, Azure DevOps, Bitbucket Server...)
# Token alone is sent as a Bearer header; with a username it is sent as Basic auth
GIT_HTTP_USERNAME=
GIT_HTTP_TOKEN=
# Optional: comma-separated hosts allowed for /api/ingest/git (empty = any https host)
GIT_ALLOWED_HOSTS=
